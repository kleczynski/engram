# Copy to .env.local and fill in real values. Never commit .env.local.

# ─── Notion ───
# Internal integration token from https://app.notion.com/developers/connections
# Capabilities: Read content (+ Update content for Week 2 write-back).
NOTION_API_KEY=ntn_replace_me
# UUID of the root page whose subtree Engram crawls.
# Share this page with the integration under Connections → Content access.
NOTION_OBSERVABILITY_ROOT_PAGE_ID=00000000000000000000000000000000
# Optional second crawl root — the Engram hub page.
# NOTION_ENGRAM_ROOT_PAGE_ID=00000000000000000000000000000000
# Optional: comma-separated top-level page titles to skip when crawling.
# NOTION_SKIP_ROOT_TITLES=Archive
# Optional: pin the Notion API version. Defaults to 2026-03-11.
# NOTION_VERSION=2026-03-11

# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace_me

# ─── Auth ───
# Passkeys are enabled in Supabase Dashboard → Authentication → Sign In / Providers.
# Sign-in URL allow list must include NEXT_PUBLIC_APP_URL.

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI — Week 2 (unused in Week 1) ───
OPENAI_API_KEY=sk-replace_me
ANTHROPIC_API_KEY=sk-ant-replace_me
# Alternative to the two keys above, via Vercel AI Gateway.
AI_GATEWAY_API_KEY=replace_me
# Random string protecting the scheduled sync endpoint.
CRON_SECRET=replace_me
